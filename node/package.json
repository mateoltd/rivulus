{
  "name": "rivulus-node",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js binding (napi-rs) over the rivulus core. Experiment scaffolding.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "napi build --platform",
    "check-contract": "node check-contract.js",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "smoke": "node smoke.js",
    "test": "node --test test/"
  },
  "napi": {
    "binaryName": "rivulus-node",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "=2.18.4",
    "@types/node": "=22.20.5",
    "typescript": "=5.9.3"
  }
}
